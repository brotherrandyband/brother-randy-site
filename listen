  <meta name="twitter:image:alt" content="Brother Randy band logo">

  <link rel="icon" type="image/jpeg" href="data:image/jpeg;base64,">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Special+Elite&display=swap" rel="stylesheet">

  <style>
    :root {
      color-scheme: light dark;
      --bg: #171512;
      --bg-deep: #100f0d;
      --surface: #1f1c18;
      --surface-hover: #29241e;
      --ink: #f1e3cf;
      --muted: #cbb99f;
      --tan: #c9a06a;
      --tan-strong: #dfb77f;
      --line: rgba(201, 160, 106, 0.62);
      --shadow: rgba(0, 0, 0, 0.45);
      --focus: #f0c890;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0d0c0b;
        --bg-deep: #080706;
        --surface: #171411;
        --surface-hover: #211d18;
        --ink: #f3e6d2;
        --muted: #c8b69c;
        --tan: #c9a06a;
        --tan-strong: #e1b77d;
        --line: rgba(201, 160, 106, 0.7);
        --shadow: rgba(0, 0, 0, 0.7);
        --focus: #f0c890;
      }
    }

    * { box-sizing: border-box; }

    html {
      min-height: 100%;
      background: var(--bg-deep);
    }

    body {
      min-height: 100vh;
      min-height: 100svh;
      margin: 0;
      overflow-x: hidden;
      background:
        radial-gradient(circle at 17% 9%, rgba(201,160,106,.045) 0 1px, transparent 1.5px) 0 0 / 19px 23px,
        radial-gradient(circle at 79% 72%, rgba(255,255,255,.025) 0 1px, transparent 1.5px) 0 0 / 31px 29px,
        linear-gradient(155deg, var(--bg) 0%, var(--bg-deep) 100%);
      color: var(--ink);
      font-family: "Barlow Condensed", "Arial Narrow", sans-serif;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: .22;
      background-image: repeating-linear-gradient(8deg, transparent 0 11px, rgba(255,255,255,.015) 12px, transparent 13px 23px);
      mix-blend-mode: screen;
    }

    main {
      position: relative;
      width: min(100%, 480px);
      margin: 0 auto;
      padding: max(38px, env(safe-area-inset-top)) 22px max(38px, env(safe-area-inset-bottom));
    }

    .identity {
      text-align: center;
      padding: 5px 0 28px;
    }

    .logo-wrap {
      width: clamp(154px, 44vw, 202px);
      aspect-ratio: 1;
      margin: 0 auto 24px;
      border-radius: 50%;
      padding: 5px;
      background: var(--tan);
      box-shadow: 0 16px 42px var(--shadow), 0 0 0 1px rgba(255,255,255,.06);
    }

    .logo {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      background: #050505;
    }

    h1 {
      margin: 0;
      color: var(--tan-strong);
      font-family: "Special Elite", Georgia, serif;
      font-size: clamp(2.3rem, 10vw, 3.4rem);
      font-weight: 400;
      line-height: .95;
      letter-spacing: .025em;
      text-shadow: 1px 1px 0 rgba(0,0,0,.9);
    }

    .release-line {
      margin: 13px 0 0;
      color: var(--ink);
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: .085em;
      line-height: 1.35;
      text-transform: uppercase;
    }

    .release-line .song { color: var(--tan-strong); }

    section + section { margin-top: 29px; }

    .section-title {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 0 0 12px;
      color: var(--muted);
      font-size: .82rem;
      font-weight: 800;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    .section-title::after {
      content: "";
      height: 1px;
      flex: 1;
      background: linear-gradient(90deg, var(--line), transparent);
    }

    .link-list {
      display: grid;
      gap: 11px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .button-link {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      min-height: 62px;
      padding: 13px 16px 13px 19px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--surface);
      color: var(--tan-strong);
      box-shadow: 0 8px 20px rgba(0,0,0,.18);
      text-decoration: none;
      transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
      -webkit-tap-highlight-color: transparent;
    }

    .button-link:hover {
      background: var(--surface-hover);
      border-color: var(--tan-strong);
    }

    .button-link:active { transform: translateY(1px); }

    .button-link:focus-visible {
      outline: 3px solid var(--focus);
      outline-offset: 3px;
    }

    .button-copy {
      min-width: 0;
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: .035em;
      line-height: 1.05;
      text-transform: uppercase;
    }

    .button-action {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin-left: 14px;
      color: var(--muted);
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .15em;
      text-transform: uppercase;
    }

    .arrow {
      width: 24px;
      height: 24px;
      border: 1px solid rgba(201,160,106,.4);
      border-radius: 50%;
      position: relative;
      flex: none;
    }

    .arrow::before,
    .arrow::after {
      content: "";
      position: absolute;
      background: var(--tan-strong);
    }

    .arrow::before {
      width: 8px;
      height: 1px;
      top: 11px;
      left: 7px;
      transform: rotate(-45deg);
      transform-origin: center;
    }

    .arrow::after {
      width: 5px;
      height: 5px;
      top: 6px;
      right: 6px;
      border-top: 1px solid var(--tan-strong);
      border-right: 1px solid var(--tan-strong);
      background: transparent;
    }

    .footer-note {
      margin: 28px 0 0;
      color: var(--muted);
      font-size: .82rem;
      font-weight: 600;
      letter-spacing: .085em;
      line-height: 1.5;
      text-align: center;
      text-transform: uppercase;
    }

    @media (max-width: 360px) {
      main { padding-inline: 16px; }
      .button-link { min-height: 59px; }
      .button-copy { font-size: 1.12rem; }
      .button-action { font-size: .66rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>
<body>
  <main>
    <header class="identity">
      <div class="logo-wrap">
        <img class="logo" src="data:image/jpeg;base64," alt="Brother Randy logo" width="1179" height="1179">
      </div>
      <h1>BROTHER RANDY</h1>
      <p class="release-line"><span class="song">MESSY</span> - debut single out now</p>
    </header>

    <section aria-labelledby="listen-title">
      <h2 class="section-title" id="listen-title">Listen</h2>
      <ul class="link-list" id="streaming-links">
        <li>
          <a class="button-link" href="https://open.spotify.com/track/0F4fPxvHOinbhdRBAaUTC9" target="_blank" rel="noopener noreferrer" aria-label="Listen to MESSY on Spotify">
            <span class="button-copy">Spotify</span>
            <span class="button-action" aria-hidden="true">Listen <span class="arrow"></span></span>
          </a>
        </li>
        <li>
          <a class="button-link" href="https://music.apple.com/us/album/messy/6806024014?i=6806024015" target="_blank" rel="noopener noreferrer" aria-label="Listen to MESSY on Apple Music">
            <span class="button-copy">Apple Music</span>
            <span class="button-action" aria-hidden="true">Listen <span class="arrow"></span></span>
          </a>
        </li>
        <li>
          <a class="button-link" href="https://youtube.com/@brotherrandyband" target="_blank" rel="noopener noreferrer" aria-label="Open Brother Randy on YouTube">
            <span class="button-copy">YouTube</span>
            <span class="button-action" aria-hidden="true">Watch <span class="arrow"></span></span>
          </a>
        </li>
        <!-- Replace the YouTube channel URL with the direct music-video link once it is live. -->
      </ul>
    </section>

    <section aria-labelledby="social-title">
      <h2 class="section-title" id="social-title">Follow Brother Randy</h2>
      <ul class="link-list">
        <li><a class="button-link" href="https://www.instagram.com/brotherrandyband/" target="_blank" rel="noopener noreferrer" aria-label="Open Brother Randy on Instagram"><span class="button-copy">Instagram</span><span class="button-action" aria-hidden="true">Follow <span class="arrow"></span></span></a></li>
        <li><a class="button-link" href="https://www.tiktok.com/@brotherrandyband" target="_blank" rel="noopener noreferrer" aria-label="Open Brother Randy on TikTok"><span class="button-copy">TikTok</span><span class="button-action" aria-hidden="true">Follow <span class="arrow"></span></span></a></li>
        <li><a class="button-link" href="https://x.com/thebrotherrandy" target="_blank" rel="noopener noreferrer" aria-label="Open Brother Randy on X"><span class="button-copy">X</span><span class="button-action" aria-hidden="true">Follow <span class="arrow"></span></span></a></li>
        <li><a class="button-link" href="https://www.facebook.com/61593798004060" target="_blank" rel="noopener noreferrer" aria-label="Open Brother Randy on Facebook"><span class="button-copy">Facebook</span><span class="button-action" aria-hidden="true">Follow <span class="arrow"></span></span></a></li>
        <li><a class="button-link" href="https://brotherrandy.com" target="_blank" rel="noopener noreferrer" aria-label="Visit the Brother Randy website"><span class="button-copy">Website</span><span class="button-action" aria-hidden="true">Visit <span class="arrow"></span></span></a></li>
      </ul>
    </section>

    <p class="footer-note">Post-hardcore meets country and Americana</p>
  </main>
</body>
</html>
